#!/bin/sh
set -eu
# Drop Rust's obsolete optimization hint and cc-rs's redundant Rust-spelled
# target. The fixed Zig target below owns this wrapper; retain every other
# argument, including any different target, unchanged and in order.
for argument do
  shift
  case "$argument" in
    -Wl,-O1|--target=aarch64-unknown-linux-musl) ;;
    *) set -- "$@" "$argument" ;;
  esac
done
exec zig cc -target aarch64-linux-musl "$@"
