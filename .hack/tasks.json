    {
      "id": "rust-check",
      "summary": "Check formatting and run Clippy for the runtime-core crate in the toolchain service.",
      "runner": {
        "kind": "compose_service",
        "service": "toolchain",
        "definition_sha256": "5eb5bd4b52eaa878821fd2929292a5c7a5df0bb6524843e0843addd7404fd767"
