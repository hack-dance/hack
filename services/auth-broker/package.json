{
  "name": "@hack/auth-broker",
  "version": "1.21.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "check": "cd ../.. && bunx ultracite check services/auth-broker/src services/auth-broker/tests",
    "auth:generate": "bunx @better-auth/cli@latest generate --config src/better-auth.ts",
    "auth:migrate": "bunx @better-auth/cli@latest migrate --config src/better-auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.5.4",
    "@neondatabase/serverless": "^1.0.2",
    "better-auth": "^1.5.4",
    "drizzle-orm": "^0.44.5",
    "elysia": "^1.4.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
