{
  "name": "@hack/cli",
  "private": true,
  "version": "3.5.1",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "bun run ../../index.ts",
    "build": "cd ../.. && bun build index.ts --compile --outfile dist/hack",
    "build:release": "cd ../.. && bun run scripts/build-release.ts",
    "build:runtime-image": "cd ../.. && bun run scripts/build-node-runtime-image.ts",
    "build:node-runtime-image": "cd ../.. && bun run scripts/build-node-runtime-image.ts --variant node-runtime",
    "build:slim-runtime-image": "cd ../.. && bun run scripts/build-node-runtime-image.ts --variant slim",
    "install:dev": "cd ../.. && bun run scripts/install-cli.ts --mode=dev --force",
    "install:bin": "cd ../.. && bun run scripts/install-cli.ts --mode=bin --force",
    "install:status": "cd ../.. && bun run scripts/install-status.ts",
    "uninstall:local": "cd ../.. && bun run scripts/uninstall-cli.ts",
    "macos:project-gen": "cd ../.. && cd apps/macos && xcodegen -c",
    "macos:open": "cd ../.. && open apps/macos/HackDesktop.xcodeproj",
    "macos:dev": "bun run macos:project-gen && bun run macos:open",
    "macos:build": "cd ../.. && cd apps/macos && swift build",
    "macos:test": "cd ../.. && cd apps/macos && swift test",
    "macos:release": "cd ../.. && ./scripts/build-macos-release.sh",
    "macos:ghostty:setup": "cd ../.. && bun run scripts/macos-ghostty-setup.ts",
    "macos:ghostty:bundle": "cd ../.. && bun run scripts/macos-ghostty-bundle.ts",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && bun test",
    "check": "cd ../.. && bunx ultracite check src packages/cli/index.ts index.ts scripts/build-release.ts scripts/build-node-runtime-image.ts scripts/install-cli.ts scripts/install-status.ts scripts/uninstall-cli.ts scripts/macos-ghostty-bundle.ts scripts/macos-ghostty-setup.ts",
    "lint": "bun run check"
  }
}
