{
  "name": "@hack/db",
  "private": true,
  "version": "1.19.1",
  "type": "module",
  "main": "src/client.ts",
  "module": "src/client.ts",
  "types": "src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./env": "./src/env.ts",
    "./schema/core": "./src/schema/core.ts"
  },
  "scripts": {
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "check": "cd ../.. && bunx ultracite check packages/db/src packages/db/drizzle.config.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.3"
  }
}
