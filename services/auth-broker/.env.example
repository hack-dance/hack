# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional OAuth scope hint; default is read:user,user:email,read:org.
# GitHub App permissions remain the primary access model.
GITHUB_SCOPES=read:user,user:email,read:org
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Optional explicit install URL override (defaults to https://github.com/apps/<slug>/installations/new)
GITHUB_APP_INSTALL_URL=

# Optional broker network settings
AUTH_BROKER_PUBLIC_BASE_URL=http://127.0.0.1:8080
HOST=0.0.0.0
PORT=8080

# Better Auth + Neon runtime
DATABASE_URL=
NEON_PROJECT_ID=
BETTER_AUTH_SECRET=
# Optional: auto-provision Better Auth users from GitHub email during callback.
BETTER_AUTH_GITHUB_AUTO_PROVISION_USERS=false
