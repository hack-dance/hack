---
title: Explicit native setup
---
flowchart TD
  Start["runtime setup"] --> Existing{"Complete matching install?"}
  Consent -->|"no"| Refused["Refuse before writes"]
  Consent -->|"yes"| Acquire["Bounded acquisition or offline inputs"]
  Existing -->|"verified"| Builder{"Image builder prepared?"}
  Existing -->|"invalid existing directory"| Preserved["Refuse and preserve"]
  Existing -->|"absent"| Consent
  Acquire --> Hash{"Every pinned hash matches?"}
  Hash -->|"no"| Retry["Report file and reason"]
  Hash -->|"yes"| Prepare["Manual prepare in staging"]
  Prepare --> Publish["Verify, sync, publish under lock"]
  Publish --> Builder
  Builder -->|"yes"| Probe["Development profile probe"]
  Builder -->|"no, consent or file"| Add["Add the image builder only"]
  Builder -->|"no, neither"| Report["Report builder not_prepared"]
  Add --> Probe
  Report --> Probe
  Retry -->|"explicit rerun"| Start
  class Refused,Preserved,Retry fail
  class Probe ok
  class Consent wait
