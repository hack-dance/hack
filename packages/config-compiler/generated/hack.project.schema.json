            "$ref": "#/$defs/Workload"
          },
          {
            "properties": {
              "restart": {
                "properties": {
                  "kind": {
                    "enum": [
                      "no",
                      "on-failure"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "default": {},
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "networks": {
      "additionalProperties": {
        "$ref": "#/$defs/Network"
      },
      "type": "object"
    },
    "open": {
      "$ref": "#/$defs/OpenConfig"
    },
    "profiles": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "routes": {
      "$ref": "#/$defs/Routes"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "services": {
      "additionalProperties": {
        "$ref": "#/$defs/Workload"
      },
      "default": {},
      "type": "object"
    },
    "source": {
      "$ref": "#/$defs/Source",
      "default": {
        "mode": "host-mounted",
        "root": "."
      }
    },
    "storage": {
      "additionalProperties": {
        "$ref": "#/$defs/Storage"
      },
      "default": {},
      "type": "object"
    },
    "worktree": {
      "$ref": "#/$defs/WorktreePolicy",
      "default": {
        "auto_branch": true,
        "inherit_local": true
      }
    }
  },
  "required": [
    "schema_version",
    "name"
  ],
  "title": "Project",
  "type": "object"
}
