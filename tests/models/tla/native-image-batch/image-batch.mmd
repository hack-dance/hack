    ready --> import: Importer available
    import --> confirmed: Exact guest readback
    import --> failed: Import refused
    fetch --> stopped: Cancel
    ready --> stopped: Cancel
    import --> unknown: Cancel
    confirmed --> [*]
    failed --> [*]
    stopped --> [*]
    unknown --> [*]
