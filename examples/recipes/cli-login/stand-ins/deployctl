#!/bin/sh
# Stand-in for a deploy platform CLI. Not a real product.
set -eu
dir="${XDG_CONFIG_HOME:-$HOME/.config}/deployctl"
case "${1:-}" in
  login)
    mkdir -p "$dir"
    umask 077
    printf 'stand-in-token-%s\n' "$(date +%s)" > "$dir/credentials"
    echo "deployctl: signed in" >&2 ;;
  whoami)
    test -s "$dir/credentials" && echo "dev@example.invalid" ;;
  token)
    test -s "$dir/credentials" || { echo "deployctl: not signed in" >&2; exit 1; }
    cat "$dir/credentials" ;;
  *) echo "usage: deployctl login|whoami|token" >&2; exit 2 ;;
esac
