flowchart TD
    event{CI event}
    event -->|Push, PR or dispatch| scope{CI suite in scope?}
    scope -->|Yes| four[Four hosted shards]
    scope -->|No| skip[Docker scope skip]
    four --> aggregate[Docker aggregate]
    four --> release[Exact-head prerelease gate]
    aggregate --> release
    event -->|Push, PR or dispatch| opt{Push, dispatch or PR label?}
    opt -->|Yes| trialscope{Trial suite in scope?}
    trialscope -->|Yes| six[Six hosted trial shards]
    six --> metrics[Advisory timings only]
    subgraph ci[CI workflow]
      scope
      four
      aggregate
      skip
    end
    subgraph trial[Separate trial workflow]
      opt
      trialscope
      six
      metrics
    end
    class four,six live
    class release ok
    class skip idle
