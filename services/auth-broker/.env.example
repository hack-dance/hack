# GitHub OAuth app credentials for the provider integration flow.
# Better Auth login can reuse these, but dedicated BETTER_AUTH_GITHUB_* creds are preferred.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional OAuth scope hint; default is read:user,user:email,read:org.
# GitHub App permissions remain the primary access model.
GITHUB_SCOPES=read:user,user:email,read:org
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Optional explicit install URL override (defaults to https://github.com/apps/<slug>/installations/new)
GITHUB_APP_INSTALL_URL=

# Linear OAuth + agent webhook credentials
# HACK_* names are preferred and match hack-cli extension defaults.
HACK_LINEAR_CLIENT_ID=
HACK_LINEAR_SECRET=
HACK_LINEAR_DEVELOPER_APP_TOKEN=
HACK_LINEAR_WEBHOOK_SECRET=
HACK_LINEAR_OAUTH_ACTOR=app
# Optional compatibility aliases for external environments:
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_DEVELOPER_APP_TOKEN=
LINEAR_WEBHOOK_SIGNING_SECRET=
# Optional OAuth/webhook overrides.
HACK_LINEAR_SCOPES=read,write,app:mentionable,app:assignable
HACK_LINEAR_AUTHORIZE_URL=https://linear.app/oauth/authorize
HACK_LINEAR_TOKEN_URL=https://api.linear.app/oauth/token
HACK_LINEAR_API_BASE_URL=https://api.linear.app
HACK_LINEAR_REDIRECT_URI=https://auth.hack.broker/linear/callback
HACK_LINEAR_WEBHOOK_PATH=/linear/webhooks
# Required to store encrypted provider-token custody for Linear local-access seeding.
# Generate a 32-byte secret (for example: `openssl rand -base64 32`) and keep it stable.
HACK_PROVIDER_TOKEN_ENCRYPTION_KEY=

# Optional broker network settings
AUTH_BROKER_PUBLIC_BASE_URL=http://127.0.0.1:8080
HOST=0.0.0.0
PORT=8080
FLOW_STORE_PATH=.data/oauth-flows.json

# Better Auth + Neon runtime
# These power the Hack account/auth shell and broker-owned remote resources.
DATABASE_URL=
NEON_PROJECT_ID=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://auth.hack.broker
# Comma-separated first-party origins allowed to call Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:8080
# Optional Better Auth social login providers shown in `/auth`.
# These are preferred over the generic provider OAuth creds when set.
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_CLIENT_SECRET=
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# Compatibility fallbacks for Better Auth social login when dedicated creds are not set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional callback-side user bootstrap helpers. These do not relax verified-email
# account-linking policy; they only allow new Better Auth user creation when no
# matching user already exists.
# Optional: auto-provision Better Auth users from GitHub email during callback.
BETTER_AUTH_GITHUB_AUTO_PROVISION_USERS=false
# Optional: auto-provision Better Auth users from Linear email during callback.
BETTER_AUTH_LINEAR_AUTO_PROVISION_USERS=false
